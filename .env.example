# ==============================================================================
# NOIR LUXURY ATELIER — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, Supabase, Cloudflare), configure these variables
# directly in your deployment platform's Environment Variables dashboard.
# NEVER commit .env.local or production secrets to source control.
# ==============================================================================

# Supabase Project Connection
# Obtain from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Master Atelier Administrator
# Email address granted full administrative privileges in the Admin Console
NEXT_PUBLIC_ADMIN_EMAIL=admin@your-domain.com
ADMIN_EMAIL=admin@your-domain.com

# Production Canonical Site URL (Used for SEO, OpenGraph, and OAuth callbacks)
# Development: http://localhost:3000
# Production: https://noir.atelier.in
NEXT_PUBLIC_SITE_URL=https://noir.atelier.in

